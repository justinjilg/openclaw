{
  "defaultAction": "SCMP_ACT_ERRNO",
  "architectures": [
    "SCMP_ARCH_X86_64",
    "SCMP_ARCH_AARCH64"
  ],
  "syscalls": [
    {
      "comment": "Container init — runc needs these to set up user/groups/caps",
      "names": [
        "capget", "capset",
        "setuid", "setuid32", "setgid", "setgid32",
        "setgroups", "setgroups32",
        "setresgid", "setresgid32", "setresuid", "setresuid32",
        "getresgid", "getresgid32", "getresuid", "getresuid32",
        "setregid", "setregid32", "setreuid", "setreuid32",
        "setfsgid", "setfsgid32", "setfsuid", "setfsuid32",
        "fchown", "fchownat"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "comment": "Process lifecycle — fork, exec, exit, wait, signals",
      "names": [
        "clone", "clone3", "fork", "vfork",
        "execve", "execveat",
        "exit", "exit_group",
        "wait4", "waitid",
        "kill", "tgkill", "tkill",
        "rt_sigaction", "rt_sigprocmask", "rt_sigreturn",
        "rt_sigpending", "rt_sigsuspend",
        "rt_sigtimedwait", "rt_sigqueueinfo", "rt_tgsigqueueinfo",
        "sigaltstack", "signalfd4", "restart_syscall"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "comment": "Thread/process identity",
      "names": [
        "getpid", "getppid", "gettid",
        "getuid", "geteuid", "getgid", "getegid",
        "getgroups",
        "getpgrp", "getpgid", "getsid",
        "setpgid", "setsid",
        "set_tid_address", "set_robust_list", "get_robust_list"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "comment": "Memory management",
      "names": [
        "brk", "mmap", "mmap2", "munmap",
        "mprotect", "mremap", "madvise",
        "mlock", "mlock2", "munlock",
        "mincore", "msync",
        "memfd_create", "membarrier",
        "rseq"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "comment": "File operations",
      "names": [
        "open", "openat", "openat2", "creat",
        "close", "close_range",
        "read", "readv", "pread64", "preadv2",
        "write", "writev", "pwrite64", "pwritev2",
        "lseek",
        "fstat", "fstatfs", "stat", "statfs", "statx",
        "lstat", "newfstatat",
        "access", "faccessat", "faccessat2",
        "dup", "dup2", "dup3",
        "fcntl", "flock",
        "fdatasync", "fsync", "sync_file_range", "syncfs",
        "ftruncate", "truncate",
        "getdents", "getdents64",
        "readlink", "readlinkat",
        "rename", "renameat", "renameat2",
        "link", "linkat", "symlink", "symlinkat",
        "unlink", "unlinkat",
        "mkdir", "mkdirat", "rmdir",
        "chdir", "fchdir", "getcwd",
        "chmod", "fchmod", "fchmodat",
        "chown", "lchown",
        "umask",
        "utimensat", "utimensat_time64", "utimes", "futimesat",
        "copy_file_range",
        "sendfile", "sendfile64", "splice", "tee"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "comment": "Extended attributes — required by pnpm/copyfile during plugin runtime-dep staging (2026.4.29+)",
      "names": [
        "getxattr", "lgetxattr", "fgetxattr",
        "setxattr", "lsetxattr", "fsetxattr",
        "removexattr", "lremovexattr", "fremovexattr",
        "listxattr", "llistxattr", "flistxattr"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "comment": "I/O hints + space preallocation — libuv's uv_fs_copyfile calls posix_fadvise(SEQUENTIAL/NOREUSE) and (with COPYFILE_EXCL) fallocate. Without these, Node fs.copyFile returns EPERM despite copy_file_range being allowed.",
      "names": [
        "fadvise64", "fadvise64_64", "readahead",
        "fallocate", "ftruncate64",
        "preadv", "pwritev",
        "eventfd", "epoll_pwait2",
        "name_to_handle_at", "open_by_handle_at",
        "pidfd_open", "pidfd_send_signal", "pidfd_getfd"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
