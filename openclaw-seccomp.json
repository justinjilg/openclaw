    {
      "comment": "Container runtime — runc needs these for /proc setup",
      "names": [
        "fsopen", "fsconfig", "fsmount", "move_mount", "open_tree",
        "fspick", "mount_setattr"
      ],
      "action": "SCMP_ACT_ALLOW"
    }
  ]
}
