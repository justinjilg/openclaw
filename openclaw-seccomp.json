      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "comment": "Misc — system info, resource limits, RNG, arch-specific",
      "names": [
        "arch_prctl", "prctl",
        "uname", "sysinfo",
        "getrlimit", "setrlimit", "prlimit64",
        "getrusage", "getcpu",
        "getrandom",
        "seccomp",
        "ioctl",
        "setpriority", "getpriority"
