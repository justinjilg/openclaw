        "getsockopt", "setsockopt",
        "shutdown"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "comment": "Epoll/poll — event loop (libuv)",
      "names": [
        "epoll_create", "epoll_create1", "epoll_ctl",
        "epoll_wait", "epoll_pwait",
        "poll", "ppoll", "select", "pselect6",
        "eventfd2", "pipe", "pipe2"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "comment": "io_uring — Node.js 22+ async I/O",
      "names": [
        "io_uring_setup", "io_uring_enter", "io_uring_register"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "comment": "Timers and clocks",
      "names": [
        "clock_gettime", "clock_getres", "clock_nanosleep",
        "gettimeofday", "nanosleep", "times",
        "timerfd_create", "timerfd_settime", "timerfd_gettime",
        "timer_create", "timer_delete", "timer_settime",
        "timer_gettime", "timer_getoverrun",
        "getitimer", "setitimer"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "comment": "Scheduling — libuv and V8 thread pool",
      "names": [
        "sched_yield",
        "sched_getaffinity", "sched_setaffinity",
        "sched_getparam", "sched_setparam",
        "sched_getattr", "sched_setattr",
