# OpenClaw Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Preferred: use ./start.sh which injects secrets from 1Password at runtime
# so you don't need a .env file at all.

# Gateway authentication token (generate with: openssl rand -hex 32)
OPENCLAW_GATEWAY_TOKEN=

# Moonshot AI (Kimi K2.5) — fallback provider
# 1Password path: op://Dev Keys/Moonshot API Key/credential
MOONSHOT_API_KEY=

# BrainstormRouter — primary LLM provider (Thompson sampling across 247 models)
# 1Password path: op://Dev Keys/BrainstormRouter API Key/credential
BRAINSTORMROUTER_API_KEY=

# Discord Bot Token (DM-only mode)
# 1Password path: op://Dev Keys/Discord Bot Token/credential
DISCORD_BOT_TOKEN=

# Paths (defaults are fine for most setups)
# OPENCLAW_CONFIG_DIR=~/.openclaw
# OPENCLAW_WORKSPACE=./workspace
