workspace/workspaces/*/br_*.sh
workspace/workspaces/*/br_*.py
workspace/workspaces/*/br_*.json
workspace/workspaces/*/br-*.md
workspace/workspaces/*/brainstormrouter_*.md
workspace/workspaces/*/bug_hunt_*
workspace/workspaces/*/prometheus_*.sh
workspace/workspaces/*/prometheus_*
workspace/workspaces/*/prometheus-*
workspace/workspaces/*/cache_*.log
workspace/workspaces/*/strategic-plan.md
workspace/workspaces/*/ai-search-competitive-analysis.md
workspace/workspaces/*/oauth-research-results.md
workspace/workspaces/*/research_*.md
workspace/workspaces/*/research/
workspace/workspaces/*/test-results/
workspace/workspaces/*/automation/
workspace/workspaces/*/skills/
workspace/workspaces/*/memory/
workspace/workspaces/*/dashboard-data.json
workspace/workspaces/*/.openclaw/

